# EditorConfig — https://editorconfig.org
# Keep this file in sync with prettier.config.js where the concerns overlap.
# prettier.config.js sets `useTabs: true`, so source files are tab-indented.

# Top-most EditorConfig file.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing whitespace is significant in Markdown (hard line breaks).
[*.md]
trim_trailing_whitespace = false

# Generated / vendored output: do not re-stylize.
[{build,.svelte-kit,node_modules}/**]
indent_style = unset
indent_size = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
